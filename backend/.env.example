# MechPartner backend configuration. Copy to backend/.env (the start scripts do this for you).

# --- Language model (the calculators work without any key) -------------------
# Get a token at https://replicate.com/account/api-tokens  (starts with r8_)
REPLICATE_API_TOKEN=

# Models on Replicate. Defaults: fast = Claude Haiku 4.5, deep review = Claude Sonnet 4.6.
# Any Replicate text model that accepts prompt / system_prompt / max_tokens works.
REPLICATE_MODEL=anthropic/claude-4.5-haiku
REPLICATE_MODEL_DEEP=anthropic/claude-sonnet-4.6

# Optional alternative: OpenAI (used only if no Replicate token is set).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL_DEEP=gpt-4o

# Force the offline (no-LLM) mode even when a key is present: 1 = on.
MECH_DEMO_MODE=

# Comma-separated origins allowed to call the API (the frontend).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
